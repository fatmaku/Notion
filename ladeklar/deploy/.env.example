# Public address (https) – used for secure cookies, links in invites and push
DOMAIN=app.ladeklar.de
BASE_URL=https://app.ladeklar.de
# Contact for push services (VAPID) and security reports
PUSH_SUBJECT=mailto:support@ladeklar.de
SECURITY_CONTACT=security@ladeklar.de
# Optional: create the licensor account on first start (remove afterwards)
PLATFORM_EMAIL=
PLATFORM_PASSWORD=
# Behind the proxy (Dockerfile: TRUST_PROXY=1) the client address is taken from X-Forwarded-For, counted
# from the right: number of trusted proxies that each append one address (only Caddy: 1)
TRUST_PROXY_HOPS=1
