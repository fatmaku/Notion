{
  "appId": "de.ladeklar.kaya",
  "appName": "Kaya Fahrer",
  "webDir": "www",
  "server": {
    "url": "https://app.ladeklar.de/t/KAYA",
    "cleartext": false,
    "allowNavigation": ["app.ladeklar.de"]
  },
  "ios": { "contentInset": "always", "limitsNavigationsToAppBoundDomains": true },
