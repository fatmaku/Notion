# Cat Me If You Can – ayarlar (Einstellungen)
#
# kur.sh bu şablondan deploy/.env dosyasını İLK çalıştırmada kendisi oluşturur ve doldurur.
# Elle değiştirmek için:  nano deploy/.env   – sonra:  bash deploy/kur.sh   (veriler korunur)
# deploy/.env gizlidir: kimseyle paylaşmayın, git'e eklenmez.
# (kur.sh legt deploy/.env aus dieser Vorlage an. Nach Änderungen: bash deploy/kur.sh)

# ---------------------------------------------------------------- Alan adı (Domain)
# Sitenin adresi, https:// olmadan. kur.sh doldurur.
SITE_DOMAIN=kedi.ornek.com
# www.<alan adı> da bu sunucuyu gösteriyorsa kur.sh kendisi yazar (www → yönlendirme). Boş = yok.
SITE_WWW=
# Let's Encrypt (ücretsiz HTTPS sertifikası) için e-posta – isteğe bağlı ama önerilir.
ACME_EMAIL=

# ---------------------------------------------------------------- Gizli anahtarlar
# Yönetim sayfası (admin.html) için yönetici anahtarı. kur.sh otomatik üretir (en az 16 karakter).
# Değiştirirseniz eski anahtar artık çalışmaz.
ADMIN_TOKEN=
# Claude (yapay zekâ) anahtarı – isteğe bağlı: https://console.anthropic.com → API Keys.
# Boşsa „basit analiz“ çalışır (sadece tüy rengi; yaş, kilo, sağlık tahmini yok).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Oyun
# Yapay zekâ: auto = anahtar varsa Claude · off = hep basit analiz · claude = anahtar şart
CATME_AI=auto
# Claude modeli (boş = claude-opus-5-5). Daha ucuz bir model yazılabilir.
CATME_MODEL=
# Demo: 1 = boş sunucuya örnek kediler, örnek kafeler (PIN 246810) ve örnek oyuncular ekler.
# Gerçek yayında 0 bırakın. Sonradan 0 yapmak örnek verileri SİLMEZ (bkz. deploy/sifirla.sh).
CATME_DEMO=0

# ---------------------------------------------------------------- İleri düzey (isteğe bağlı)
# Harita karoları: varsayılan OpenStreetMap (az trafik için uygun). Çok trafikte kendi
# karo servisinizi yazın, ör. https://…/{z}/{x}/{y}.png ve telif yazısı:
CATME_TILES=
CATME_TILES_ATTRIB=
