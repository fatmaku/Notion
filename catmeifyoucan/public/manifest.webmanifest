{
  "name": "Cat Me If You Can · Kadıköy",
  "short_name": "Cat Me",
  "description": "Kadıköy'ün sokak kedilerini fotoğrafla, yakala, KediDex'ini doldur.",
  "lang": "tr",
  "start_url": "./app.html#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#14213d",
  "theme_color": "#14213d",
  "categories": ["games", "lifestyle", "social"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Yakala!", "url": "./app.html#/catch", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Kupon", "url": "./app.html#/voucher", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
