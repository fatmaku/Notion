{
  "name": "livefx",
  "version": "1.6.0",
  "description": "Live memes, stickers and sound effects for livestreams – triggered by what the streamer says.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e.js",
    "setup-offline": "node scripts/setup-offline.js"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
